<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="${applicationId}.permission.JPUSH_MESSAGE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data
                android:host="qun.qq.com"
                android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data
                android:host="t.me"
                android:scheme="https" />
        </intent>

        <package android:name="tv.danmaku.bili" />

        <!-- 外部播放器 Animeko：deep link 可见性（Android 11+ 包过滤）。
             scheme+host 声明不锁包名（Animeko 换包名/新变体仍可发现），包名声明保证精确可见 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data
                android:host="subjects"
                android:scheme="ani" />
        </intent>
        <package android:name="me.him188.ani" />
    </queries>

    <application
        android:name=".AnimeTrackApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnimeTrack"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/Theme.AnimeTrack.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台播放服务：锁屏/切后台持续播放 + 通知栏媒体控制 -->
        <service
            android:name="com.aiexile.animetrack.data.player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service> <!-- JPush SDK Service -->
        <service
            android:name=".push.PushService"
            android:enabled="true"
            android:exported="false"
            android:process=":pushcore">
            <intent-filter>
                <action android:name="cn.jiguang.user.service.action" />
            </intent-filter>
        </service> <!-- JPush SDK Receiver -->
        <receiver
            android:name=".push.PushReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.RECEIVER_MESSAGE" />

                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>

        <!-- 桌面组件：今日放送 / 在看清单 / 追番统计 -->
        <receiver
            android:name=".ui.widget.TodayAiringWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_airing_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.WatchingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_watching_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watching_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.StatsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stats_widget_info" />
        </receiver>

        <!-- OPPO 厂商推送：使用字符串资源避免纯数字被解析为 Integer -->
        <meta-data
            android:name="OPPO_APPKEY"
            android:value="@string/oppo_appkey"
            tools:node="replace" />
        <meta-data
            android:name="OPPO_APPID"
            android:value="@string/oppo_appid"
            tools:node="replace" />
        <meta-data
            android:name="OPPO_APPSECRET"
            android:value="@string/oppo_appsecret"
            tools:node="replace" /> <!-- VIVO 厂商推送：使用字符串资源避免纯数字被解析为 Integer -->
        <meta-data
            android:name="com.vivo.push.api_key"
            android:value="@string/vivo_appkey"
            tools:node="replace" />
        <meta-data
            android:name="com.vivo.push.app_id"
            android:value="@string/vivo_appid"
            tools:node="replace" /> <!-- 魅族厂商推送：使用字符串资源避免纯数字被解析为 Integer -->
        <meta-data
            android:name="MEIZU_APPKEY"
            android:value="@string/meizu_appkey"
            tools:node="replace" />
        <meta-data
            android:name="MEIZU_APPID"
            android:value="@string/meizu_appid"
            tools:node="replace" />
    </application>

</manifest>